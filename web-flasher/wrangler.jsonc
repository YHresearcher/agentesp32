{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentesp32",
  "main": "./_worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
